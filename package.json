{
	"name": "@86d-app/86d",
	"version": "0.0.4",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:apps": "turbo run build --filter=./apps/*",
		"build:packages": "turbo run build --filter=./packages/*",
		"build:store": "turbo run build --filter=./apps/store",
		"typecheck": "turbo run typecheck",
		"check": "turbo run check",
		"check:fix": "turbo run check:fix",
		"clean": "turbo run clean && git clean -xdf .turbo .next node_modules coverage logs playwright-report",
		"dev": "dotenv -- turbo run dev --filter=store",
		"dev:store": "dotenv -- turbo run dev --filter=store",
		"start": "turbo run start",
		"test": "turbo run test",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:store": "playwright test --project=store-chromium",
		"test:e2e:ui": "playwright test --ui",
		"postinstall": "bun run generate:modules -- --frozen",
		"generate:modules": "tsx scripts/generate-modules.ts",
		"generate:registry": "tsx scripts/generate-registry.ts",
		"generate:docs": "tsx scripts/generate-component-docs.ts",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build --filter=./packages/* --filter=./modules/* && changeset publish",
		"86d": "tsx packages/cli/src/index.ts",
		"prisma": "cd packages/db && dotenv -e ../../.env -- bun run prisma",
		"db:seed": "dotenv -- tsx scripts/seed.ts",
		"seed:fetch-luxury-assets": "tsx scripts/seed/fetch-luxury-stock-assets.ts",
		"bump-version": "tsx scripts/bump-version.ts",
		"install:ci": "bun install --frozen-lockfile",
		"audit": "bun pm untrusted && npm audit --audit-level=high"
	},
	"dependencies": {
		"@86d-app/registry": "workspace:*",
		"tsx": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.2",
		"@biomejs/biome": "catalog:",
		"@changesets/changelog-github": "0.6.0",
		"@changesets/cli": "2.31.0",
		"@playwright/test": "1.59.1",
		"@tsconfig/node-ts": "catalog:",
		"@tsconfig/node24": "catalog:",
		"@tsconfig/strictest": "catalog:",
		"@types/node": "catalog:node",
		"@types/pg": "8.20.0",
		"@vitest/coverage-v8": "4.1.5",
		"dotenv-cli": "catalog:",
		"pg": "8.20.0",
		"sharp": "0.34.5",
		"turbo": "2.9.6",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"engines": {
		"node": "23 || 24 || 25"
	},
	"workspaces": [
		"apps/*",
		"internals/*",
		"modules/*",
		"packages/*"
	],
	"catalog": {
		"@biomejs/biome": "2.4.13",
		"@tsconfig/node-ts": "23.6.4",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/strictest": "2.0.8",
		"dotenv-cli": "11.0.0",
		"@tailwindcss/postcss": "4.2.4",
		"postcss": "8.5.10",
		"slug": "^11.0.1",
		"tailwindcss": "4.2.4",
		"tsx": "4.21.0",
		"turbo": "2.9.6",
		"type-fest": "5.6.0",
		"typescript": "6.0.3",
		"zod": "4.3.6"
	},
	"catalogs": {
		"mdx": {
			"@mdx-js/loader": "3.1.1",
			"@mdx-js/react": "3.1.1",
			"@next/mdx": "16.2.4",
			"@types/mdx": "2.0.13"
		},
		"next": {
			"@next/third-parties": "16.2.4",
			"@types/next": "9.0.0",
			"next": "16.2.4",
			"next-themes": "0.4.6"
		},
		"node": {
			"@types/node": "25.6.0"
		},
		"prisma": {
			"@prisma/client": "7.8.0",
			"prisma": "7.8.0"
		},
		"react": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"react": "19.2.5",
			"react-dom": "19.2.5",
			"react-use": "17.6.0"
		},
		"trpc": {
			"@tanstack/react-query": "5.100.1"
		},
		"vercel": {
			"@vercel/analytics": "1.6.1"
		},
		"vite": {
			"vite": "8.0.10",
			"vite-tsconfig-paths": "^6.0.3",
			"vitest": "4.1.5"
		}
	},
	"packageManager": "bun@1.3.6"
}
